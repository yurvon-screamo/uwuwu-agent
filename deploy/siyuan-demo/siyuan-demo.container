# systemd user-юнит: quadlet генерит siyuan-demo.service из этого файла.
# Применение правок: systemctl --user daemon-reload (+ restart).
# Каноническая копия с плейсхолдером вместо accessAuthCode — репо uwuwu-agent,
# deploy/siyuan-demo/ (этот файл хост-локальный, код — доступ к вики).

[Unit]
Description=SiYuan kernel — хранилище uwuwu (quadlet)
# Рестарт при любом exit без потолка burst-лимита: tight-loop рестартов
# безопаснее, чем «юнит навсегда failed» у единственного хранилища
StartLimitIntervalSec=0

[Container]
ContainerName=siyuan-demo
Image=docker.io/b3log/siyuan:v3.8.10-alpha.5
Network=pasta
PublishPort=0.0.0.0:6806:6806
Volume=/home/yurvon/siyuan-demo-ws:/siyuan/workspace
Exec=serve --workspace=/siyuan/workspace --accessAuthCode=<accessAuthCode>

[Service]
# любой exit, включая чистый (0) — основное отверстие миграции
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
