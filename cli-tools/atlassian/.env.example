# Atlassian CLI credentials and endpoints.
# Copy to .env and fill in. Process env (e.g. $env:CONFLUENCE_PERSONAL_TOKEN) overrides .env.

CONFLUENCE_USERNAME=user@example.com
JIRA_USERNAME=user@example.com
CONFLUENCE_URL=https://wiki.example.com
JIRA_URL=https://jira.example.com/

# Tokens (Personal Access Tokens). Leave empty in .env.example, fill in .env.
CONFLUENCE_PERSONAL_TOKEN=
JIRA_PERSONAL_TOKEN=
