{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "developer",
    "provider": {
        "smos": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "smos",
            "options": {
                "baseURL": "http://localhost:8888/v1"
            },
            "models": {
                "uwuwu": {
                    "name": "uwuwu"
                }
            }
        }
    },
    "command": {
        "wiki": {
            "template": "Были ли получены ранее неизвестные навыки работы с инструментами? Стоит ли дополнить статьи в wiki? Или создать новые? Если да, то создавай запрос на изменение в wiki.",
            "description": "Wiki request"
        },
        "goal": {
            "template": "Действуй пока поставленная цель не будет достигнута. Я как пользователь ушел."
        }
    },
    "mcp": {},
    "permission": {
        "skill": {
            "flow-*": "deny",
            "tool-*": "deny",
            "engineer-*": "deny",
            "office-coworker-*": "deny",
            "rules-*": "allow",
            "tool-generic-*": "allow"
        },
        "task": {
            "*": "deny"
        }
    },
    "tools": {
        "wiki_*": true,
        "time_*": true,
        "bg_*": true,
        "vision_*": true
    },
    "plugin": ["@warp-dot-dev/opencode-warp"]
}
