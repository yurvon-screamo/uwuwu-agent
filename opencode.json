{
  "$schema": "https://opencode.ai/config.json",
  "commands": {
    "bdd-plan": {
      "template": "\u0421\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u0443\u0439 \u044d\u0442\u043e \u0432 \u0432\u0438\u0434\u0435 \u0440\u044f\u0434\u0430 \u0433\u0438\u0440\u043a\u0438\u043d \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0435\u0432 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043c\u044b \u0442\u043e\u0447\u043d\u043e \u043f\u043e\u043d\u044f\u043b\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430."
    },
    "fast": {
      "template": "\u042e\u0437\u0435\u0440 \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439, \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u0439 \u043a\u043e\u0434 \u0440\u0435\u0432\u044c\u044e\u0432\u0435\u0440\u0430, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e. \u0415\u0441\u043b\u0438 \u0442\u044b \u0441\u0447\u0438\u0430\u0442\u0435\u0448\u044c \u0447\u0442\u043e \u044e\u0437\u0435\u0440 \u043e\u0448\u0438\u0431\u0430\u0435\u0442\u0441\u044f \u0438 \u0437\u0430\u0434\u0430\u0447\u0430 \u0432\u0441\u0435 \u0442\u0430\u043a\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u0435\u0432\u044c\u044e, \u0442\u043e \u0434\u0435\u043b\u0430\u0439 \u043a\u0430\u043a \u0441\u0447\u0438\u0442\u0430\u0435\u0448\u044c \u043d\u0443\u0436\u043d\u044b\u043c"
    },
    "goal": {
      "template": "goal: $ARGUMENTS\n(\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0443\u0448\u0451\u043b \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0435 \u0436\u0434\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432. \u041d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c \u043a\u043e\u0434-\u0440\u0435\u0432\u044c\u044e \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435\u043c \u2014 \u044d\u0442\u043e \u0432\u0430\u0436\u043d\u043e.)",
      "description": "GOAL-\u0440\u0435\u0436\u0438\u043c: \u0430\u0433\u0435\u043d\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u043e \u0434\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0446\u0435\u043b\u0438, \u0441\u0443\u0434\u044c\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u043f\u043e \u0444\u0430\u043a\u0442\u0430\u043c"
    },
    "search": {
      "template": "\u0425\u0432\u0430\u0442\u0438\u0442 \u0433\u0430\u0434\u0430\u0442\u044c. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0440\u0435\u0441\u0435\u0440\u0447 - \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442/wiki/access/\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f"
    },
    "tdd": {
      "template": "\u041d\u0430\u0447\u043d\u0438 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434 \u0431\u0430\u0433\u043e\u043c \u0441 TDD - \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0431\u0430\u0433, \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0442\u043e\u043c \u043f\u043b\u0430\u043d \u0438 \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435. \u0412 TDD \u043f\u043e\u0434\u0445\u043e\u0434\u0435 \u0442\u044b \u043d\u0435 \u0436\u0434\u0435\u0448\u044c \u043e\u0442 \u043c\u0435\u043d\u044f \u0430\u043f\u0440\u0443\u0432\u0430. \u0415\u0441\u043b\u0438 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0441\u044f \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0431\u0430\u0433, \u0442\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0434\u0435\u043b\u0430\u0439 \u0438 \u0437\u043e\u0432\u0438 \u043c\u0435\u043d\u044f"
    },
    "worktree": {
      "template": "\u0420\u0430\u0431\u043e\u0442\u0430\u0439 \u0432 \u0441\u0432\u0435\u0436\u0435\u043c git worktree, \u043a\u0430\u043a \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0448\u044c \u0440\u0430\u0431\u043e\u0442\u0443 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0439 PR, \u0432\u043a\u043b\u044e\u0447\u0430\u0439 watch \u0437\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c CI + \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c \u0443\u0434\u0430\u043b\u0438\u0442\u044c worktree \u043a\u0430\u043a \u0432\u0441\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0448\u044c \u0438 ci \u0431\u0443\u0434\u0435\u0442 \u0437\u0435\u043b\u0435\u043d\u044b\u043c."
    },
    "wiki": {
      "description": "Wiki request",
      "template": "\u0411\u044b\u043b\u0438 \u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u044b \u0440\u0430\u043d\u0435\u0435 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043d\u0430\u0432\u044b\u043a\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438? \u0421\u0442\u043e\u0438\u0442 \u043b\u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0441\u0442\u0430\u0442\u044c\u0438 \u0432 wiki? \u0418\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0435? \u0415\u0441\u043b\u0438 \u0434\u0430, \u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0439 \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432 wiki."
