{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "goal-mode.ts",
    "cron-mode.ts",
    "sticky-retry/index.ts",
    "sticky-retry/contract.ts",
    "sticky-retry/tui.tsx",
    "arkive/tui.tsx",
    "../lib/goal-lib.ts",
    "../lib/cron-lib.ts",
    "../tests/goal-mode.test.ts",
    "../tests/cron-lib.test.ts",
    "../plugins-tests/sticky-retry.test.ts",
    "../plugins-tests/sticky-retry-contract.test.ts",
    "../plugins-tests/sticky-retry-forwarder.test.ts"
  ]
}
